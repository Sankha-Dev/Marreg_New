                                <button type="button" id="btn-orig" class="font01 active01" aria-label="Reset text size">
                                    A
                                </button>

                                <button type="button" id="btn-increase" class="font01" aria-label="Increase text size">
                                    A+
                                </button><span class="partition ">|</span>

