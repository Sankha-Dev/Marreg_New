<%@ Master Language="VB" %>

<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">

<meta charset="utf-8" />    
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>MARREG</title>
    <link rel="stylesheet" href="css/fontawesome.min.css"/>
    <link href="css/ux4g-v1.0.1.css" rel="stylesheet"/>
    <link href="css/html-template-1.css" rel="stylesheet"/>
    <link href="css/accesibility-style_v1.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://img1.digitallocker.gov.in/nad/v-22/assets/css/fontawesome.min.css"/>
    <link rel="stylesheet" href="css/stylesheet.css"/>
    <style>
        .accessibility.banner {
            background-color: #e8f5e9;
        }
        #about-details {
            display: none;
        }
        .service-card {
            height: 250px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
            box-sizing: border-box;
        }

            .service-card img {
                width: 80px;
                height: 80px;
                object-fit: contain;
                margin-bottom: 15px;
            }

            .service-card h3 {
                margin: 0;
                min-height: 50px;
                display: flex;
                align-items: center;
                justify-content: center;
                line-height: 1.3;
            }

        @media (max-width: 767px) {
            .service-card {
                height: 220px;
            }
        }
        .our-ministers p,
        .our-ministers h3 {
            color: #3B3369;
        }
    </style>
 <!-- JS here -->
<script src="https://img1.digitallocker.gov.in/nad/v-22/assets/js/jquery.min.js"></script>
<script src="https://img1.digitallocker.gov.in/ux4g/UX4G@1.0.0-beta1/js/ux4g.bundle.min.js"></script>


<style>
    .accessibility.banner {
        background-color: #e8f5e9;
    }

    /* Fix dropdown item wrapping */
    .navbar .dropdown-menu {
        width: max-content;
        min-width: 200px;
    }

        .navbar .dropdown-menu .dropdown-item {
            white-space: nowrap;
        }
</style>
    <asp:ContentPlaceHolder id="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
    <div>
        <header>
