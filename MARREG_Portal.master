        <script type="text/javascript">

            function showCMBanner() {
                // Get the modal
                var modal = document.getElementById('myModal');

                // Get the image and insert it inside the modal - use its "alt" text as a caption
                var img = document.getElementById('myImg');
                var modalImg = document.getElementById("img01");
                var captionText = document.getElementById("caption");
                var header = document.getElementById("header_swf_image")
                //document.getElementById('marreg_video').style.display = "none";
                document.getElementById("")
                img.onclick = function () {
                    modal.style.display = "block";
                    modalImg.src = this.src;
                    captionText.innerHTML = this.alt;
                    var imgs = document.getElementById("sspic");
                    imgs.style.display = "none";
                    //document.getElementById('sspic').className = 'divhide_css';                        
                    header.style.display = "none";
                }

                // Get the <span> element that closes the modal
                var span = document.getElementsByClassName("close")[0];

                // When the user clicks on <span> (x), close the modal
                span.onclick = function () {
                    window.location.reload(true);
                    modal.style.display = "none";
                    var imgs = document.getElementById("sspic");
                    imgs.style.display = "block";
                    header.style.display = "block";

                }
            }

            function showMARREGVideo() {
                var modal = document.getElementById('Video_Modal');
                var img = document.getElementById('img_video');

                document.getElementById("")
                img.onclick = function () {
                    modal.style.display = "block";
                }
                var span = document.getElementsByClassName("close")[1];
                span.onclick = function () {
                    modal.style.display = "none";
                }
            }
  </script>
        <div id="feedbackBox" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%, -50%);width:50%;max-width:600px;background:white;padding:30px;border-radius:15px; border:1px solid #ccc;box-shadow:0 0 25px rgba(0,0,0,0.3);z-index:999999;">
            <h2 style="text-align:center; margin-bottom:20px;">How was your experience?</h2>

            <div style="display:flex;justify-content:space-around;align-items:center;margin-top:20px;">

        <div class="emoji-option" onclick="sendFeedback('excellent')" style="text-align:center;">
            <i class="fas fa-star emoji-icon" style="color:#ffcc00;"></i>
            <div class="emoji-label">Excellent</div>
        </div>

        <div class="emoji-option" onclick="sendFeedback('good')" style="text-align:center;">
            <i class="fas fa-thumbs-up emoji-icon" style="color:#ffcc00;"></i>
            <div class="emoji-label">Good</div>
        </div>

        <div class="emoji-option" onclick="sendFeedback('ok')" style="text-align:center;">
            <i class="fas fa-check-circle emoji-icon" style="color:#ffcc00;"></i>
            <div class="emoji-label">OK</div>
        </div>

    </div>
</div>
       

    
    </form>

   <style>
    .emoji-option {
        cursor:pointer;
        transition: transform 0.2s ease, color 0.2s ease;
    }

    .emoji-icon {
        font-size:70px;
        transition: transform 0.2s ease-in-out, color 0.2s ease-in-out;
    }

    .emoji-label {
        margin-top:10px;
        font-size:20px;
        font-weight:bold;
    }

    .emoji-option:hover .emoji-icon {
        transform:scale(1.3);
        filter:brightness(1.3);
    }

    .emoji-option:hover .emoji-label {
        color:#007bff;
    }
</style>

   <script type="text/javascript">
         function showpop6(msg, title) {
             toastr.options = {
                 "closeButton": true,
                 "debug": false,
                 "newestOnTop": false,
                 "progressBar": true,
                 "positionClass": "toast-bottom-left",
                 "preventDuplicates": true,
                 "onclick": null,
                 "showDuration": "300",
                 "hideDuration": "1000",
                 "timeOut": "6000",
                 "extendedTimeOut": "1000",
                 "showEasing": "swing",
                 "hideEasing": "linear",
                 "showMethod": "fadeIn",
                 "hideMethod": "fadeOut"
             }
             toastr.error(msg, title);
             return false;
         }

         function showpop5(msg, title) {
             toastr.options = {
                 "closeButton": true,
                 "debug": false,
                 "newestOnTop": false,
                 "progressBar": true,
                 "positionClass": "toast-bottom-left",
                 "preventDuplicates": true,
                 "onclick": null,
                 "showDuration": "300",
                 "hideDuration": "1000",
                 "timeOut": "6000",
                 "extendedTimeOut": "1000",
                 "showEasing": "swing",
                 "hideEasing": "linear",
                 "showMethod": "fadeIn",
                 "hideMethod": "fadeOut"
             }
             toastr.success(msg, title);
             return false;
         }
     </script>

   <script>
        let startTime = Date.now();

        function trackPageCount() {
            let count = localStorage.getItem("pageCount");
            if (!count) count = 0;
            count = parseInt(count) + 1;
            localStorage.setItem("pageCount", count);

            if (count === 4) {
                localStorage.setItem("triggerAfter2", "yes");
            }
        }

        function checkToShowFeedback() {
            const trigger = localStorage.getItem("triggerAfter2");
            const given = localStorage.getItem("feedbackGiven");
            if (trigger === "yes" && given !== "yes") {
                showFeedback();
            }
        }

        window.addEventListener("beforeunload", function () {
            const duration = Date.now() - startTime;

            if (localStorage.getItem("triggerAfter2") === "yes" &&
                localStorage.getItem("feedbackGiven") !== "yes") {
                showFeedback();
            }

            sendData({
                type: "duration",
                page: window.location.pathname,
                ms: duration
            });
        });

        function showFeedback() {
            document.getElementById("feedbackBox").style.display = "block";
        }

        function sendFeedback(smiley) {
            sendData({
                type: "feedback",
                page: window.location.pathname,
                smiley: smiley
            });
            localStorage.setItem("feedbackGiven", "yes");
            document.getElementById("feedbackBox").style.display = "none";
        }

        function sendData(data) {
            return fetch("/Track.ashx", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            })
                .then(response => response.text())
                .then(msg => {
                    if (msg.includes("Thanks for Your Feedback") || msg.includes("Saved")) {
                        showpop5(msg, "Feedback");
                    } else {
                        /*showpop6(msg, "Error");*/
                    }
                })
                .catch(err => {
                    showpop6("Unable to save feedback", "Error");
                });
        }

        trackPageCount();
        checkToShowFeedback();
    </script>
</body>
</html>