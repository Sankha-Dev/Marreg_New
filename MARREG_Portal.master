    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <script type="text/javascript">
        var clicked = false;
        function CheckBrowser()
        {
            if (clicked)
            {
                clicked = false;
            }
        }
        function bodyUnload()
        {
            if (clicked == false)//browser is closed
            {
                var request = GetRequest();
                request.open("GET", "../MARREG_Portal/Portal_Logout.aspx", true);
                request.send();
            }
        }

        function GetRequest()
        {
            var xmlHttp = null;
            try
            {
                // Firefox, Opera 8.0+, Safari
                xmlHttp = new XMLHttpRequest();
            }
            catch (e)
            {
                //Internet Explorer
                try
                {
                    xmlHttp = new ActiveXObject("Msxml2.XMLHTTP");
                }
                catch (e)
                {
                    xmlHttp = new ActiveXObject("Microsoft.XMLHTTP");
                }
            }
            return xmlHttp;
        }

        $(document).ready(function ()
        {
            //catch the right-click context menu
            $(document).bind("contextmenu", function (e)
        {
                //warning prompt - optional
                alert("Right-click is not allowed!");

                //delete the default context menu
                return false;
            });
        });
        window.history.forward(1);
        document.attachEvent("onkeydown", my_onkeydown_handler);
        function my_onkeydown_handler() {
            switch (event.keyCode) {
                case 116: // F5;

                    event.returnValue = false;
                    event.keyCode = 0;
                    //window.status = "We have disabled F5";
                    break;
                case 123:
                    event.returnValue = false;
                    event.keyCode = 0;
                    //window.status = "We have disabled F12";
                    break;
            }
        }
       
    </script>
    <%--Modal show and hide--%>
     <script type="text/javascript">
         function myMouseOver(e) {
             modalClose(e);
             $find(e).show();
             //modalClose(e);
             //setTimeout(function () { myMouseOut(e) }, 15000);
         }
         //function myMouseOut(e) {
         //    $find(e).hide();
         function modalClose(e) {

             var modalPopup = $find(e);
             //alert("open");

             modalPopup.add_shown(function () {
                 //alert("close_0");
                 modalPopup._backgroundElement.addEventListener("click", function () {
                     //alert("close");
                     modalPopup.hide();
                 });
             });
         };
         //}
    </script>
